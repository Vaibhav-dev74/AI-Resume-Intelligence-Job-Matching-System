PROJECT_NAME="AI Resume Intelligence & Job Matching Platform"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"
DEBUG=true

HOST="0.0.0.0"
PORT=8000

SECRET_KEY="generate-a-strong-random-secret-key-for-production"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501","http://localhost:8000"]
MAX_UPLOAD_SIZE_MB=10

DATABASE_URL="sqlite+aiosqlite:///./resume_intelligence.db"
DATABASE_URL_SYNC="sqlite:///./resume_intelligence.db"

MODEL_PROVIDER="local"
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

OPENAI_API_KEY=""
GEMINI_API_KEY=""

MATCHING_WEIGHT_REQUIRED_SKILLS=0.40
MATCHING_WEIGHT_SEMANTIC_SIMILARITY=0.20
MATCHING_WEIGHT_EXPERIENCE_RELEVANCE=0.15
MATCHING_WEIGHT_PREFERRED_SKILLS=0.10
MATCHING_WEIGHT_PROJECT_RELEVANCE=0.10
MATCHING_WEIGHT_EDUCATION_MATCH=0.05
TRANSFERABLE_SKILL_PENALTY=0.75
