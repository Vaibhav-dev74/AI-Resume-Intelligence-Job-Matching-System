# IntelliResume AI — Streamlit Secrets Configuration Template
# In Streamlit Cloud, paste these under: App Settings -> Secrets

# Model Provider ("local", "openai", "gemini")
MODEL_PROVIDER = "local"

# Optional Cloud LLM API Keys (Leave empty if using local offline mode)
OPENAI_API_KEY = ""
GEMINI_API_KEY = ""

# Security Secret Key
SECRET_KEY = "generate-a-strong-random-secret-key-for-production"

